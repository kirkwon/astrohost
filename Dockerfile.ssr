# Multi-stage Dockerfile for Astro SSR using the Node standalone adapter
# Builds the project and runs the standalone server produced by `@astrojs/node`.

FROM node:20-alpine AS builder
WORKDIR /app

# Copy package manifests and install dependencies
COPY package.json package-lock.json* pnpm-lock.yaml* ./
RUN npm ci --silent || npm install --silent

# Copy source and build
COPY . .
RUN npm run build

FROM node:20-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production

# Copy build output and node_modules from builder
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/node_modules ./node_modules

# Expose the port the standalone server listens on (Astro preview default is 3000)
EXPOSE 3000

# Entrypoint: adjust path if your adapter writes a different entry file.
CMD ["node", "./dist/server/entry.mjs"]
