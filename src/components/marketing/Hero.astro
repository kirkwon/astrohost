---
import { Button } from "@/components/ui/button";
---

<section class="w-full py-12 md:py-24 lg:py-32">
  <div class="container px-4 md:px-6">
    <div class="grid gap-6 lg:grid-cols-2 lg:gap-12">
      <div class="flex flex-col justify-center space-y-4">
        <div class="space-y-2">
          <h1 class="text-4xl font-bold tracking-tighter sm:text-5xl md:text-6xl">
            Build the Future of the Web
          </h1>
          <p class="max-w-[600px] text-muted-foreground md:text-xl">
            This is a starting point for a modern, beautiful, and performant web
            application built with Astro.js.
          </p>
        </div>
        <div class="flex flex-col gap-2 min-[400px]:flex-row">
          <a href="#">
            <Button>Get Started</Button>
          </a>
          <a href="#">
            <Button variant="secondary">Learn More</Button>
          </a>
        </div>
      </div>
      <img
        src="https://images.unsplash.com/photo-1551434678-e076c223a692?q=80&w=2070&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D"
        alt="Hero Image"
        class="mx-auto aspect-video overflow-hidden rounded-xl object-cover object-center sm:w-full"
      />
    </div>
  </div>
</section>
