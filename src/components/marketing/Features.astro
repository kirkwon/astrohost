<section class="w-full py-12 md:py-24 lg:py-32 bg-muted">
  <div class="container px-4 md:px-6">
    <div class="flex flex-col items-center justify-center space-y-4 text-center">
      <div class="space-y-2">
        <div class="inline-block rounded-lg bg-muted-foreground px-3 py-1 text-sm text-background">
          Key Features
        </div>
        <h2 class="text-3xl font-bold tracking-tighter sm:text-5xl">
          Everything You Need to Succeed
        </h2>
        <p class="max-w-[900px] text-muted-foreground md:text-xl/relaxed lg:text-base/relaxed xl:text-xl/relaxed">
          Astro gives you the tools and flexibility to build any website you can imagine, from personal blogs to large e-commerce sites.
        </p>
      </div>
    </div>
    <div class="mx-auto grid max-w-5xl items-center gap-6 py-12 lg:grid-cols-3 lg:gap-12">
      <div class="grid gap-1">
        <h3 class="text-xl font-bold">Component Islands</h3>
        <p class="text-muted-foreground">
          Ship less JavaScript with Astro's next-gen island architecture.
        </p>
      </div>
      <div class="grid gap-1">
        <h3 class="text-xl font-bold">Server-First</h3>
        <p class="text-muted-foreground">
          Fetch data on the server and render static HTML for ultimate performance.
        </p>
      </div>
      <div class="grid gap-1">
        <h3 class="text-xl font-bold">Integrations</h3>
        <p class="text-muted-foreground">
          Use your favorite UI frameworks like React, Vue, and Svelte.
        </p>
      </div>
    </div>
  </div>
</section>
