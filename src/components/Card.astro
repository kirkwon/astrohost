---
import type { CollectionEntry } from 'astro:content';

interface Props {
	post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
---

<a href={`/blog/${post.slug}`} class="block p-8 bg-white dark:bg-slate-800 border-2 border-slate-200 dark:border-slate-700 rounded-xl shadow-lg hover:shadow-xl transition-all duration-300 hover:border-primary-500 dark:hover:border-primary-400 hover:-translate-y-1">
    <h5 transition:name={`post-title-${post.slug}`} class="mb-3 text-4xl font-black tracking-tight text-slate-900 dark:text-white hover:text-primary-700 dark:hover:text-primary-300 transition-colors">{post.data.title}</h5>
    <p class="font-medium text-slate-600 dark:text-slate-300 text-lg">{post.data.description}</p>
    <div class="mt-4 flex items-center text-primary-600 dark:text-primary-400 font-semibold text-base">
        <span>Read more</span>
        <span class="ml-2 text-lg group-hover:translate-x-1 transition-transform">→</span>
    </div>
</a>
