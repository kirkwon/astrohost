---
import type { CollectionEntry } from 'astro:content';

interface Props {
	post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
---

<a href={`/blog/${post.slug}`} class="tilt-card block p-8 bg-white/70 dark:bg-slate-800/60 border-2 border-slate-200/50 dark:border-slate-700/50 rounded-xl shadow-lg transition-all duration-300 hover:border-primary-500 dark:hover:border-primary-400 backdrop-blur-md relative overflow-hidden group">
    <div class="absolute inset-0 bg-gradient-to-br from-primary-500/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>
    <div class="relative z-10 pointer-events-none">
        <h5 transition:name={`post-title-${post.slug}`} class="mb-3 text-4xl font-black tracking-tight text-slate-900 dark:text-white hover:text-primary-700 dark:hover:text-primary-300 transition-colors decipher-text pointer-events-auto" data-original={post.data.title}>{post.data.title}</h5>
        <div class="mb-2 inline-block px-3 py-1 bg-slate-100/80 dark:bg-slate-700/80 rounded-full text-sm font-bold font-mono text-slate-600 dark:text-slate-300 pointer-events-auto">
            {new Date(post.data.pubDate).getFullYear()}
        </div>
        <p class="font-medium text-slate-600 dark:text-slate-300 text-lg pointer-events-auto">{post.data.description}</p>
        <div class="mt-4 flex items-center text-primary-600 dark:text-primary-400 font-semibold text-base pointer-events-auto">
            <span>Read more</span>
            <span class="ml-2 text-lg group-hover:translate-x-1 transition-transform">→</span>
        </div>
    </div>
</a>

<script>
    import VanillaTilt from 'vanilla-tilt';

    document.addEventListener("astro:page-load", () => {
        // Destroy existing instances on navigation if any to prevent memory leaks and duplication
        const existingCards = document.querySelectorAll(".tilt-card");
        existingCards.forEach((card: any) => {
            if(card.vanillaTilt) {
                card.vanillaTilt.destroy();
            }
        });

        // Initialize Vanilla Tilt
        VanillaTilt.init(Array.from(existingCards) as HTMLElement[], {
            max: 5,
            speed: 400,
            glare: true,
            "max-glare": 0.15,
        });

        // Decipher text effect on hover
        const decipherElements = document.querySelectorAll('.decipher-text');
        const characters = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@#$%^&*()';

        decipherElements.forEach((el: any) => {
            // Remove existing listeners if any
            if(el._mouseEnterHandler) {
                el.removeEventListener('mouseenter', el._mouseEnterHandler);
                el.removeEventListener('mouseleave', el._mouseLeaveHandler);
            }

            el._mouseEnterHandler = () => {
                const originalText = el.getAttribute('data-original');
                if(!originalText) return;

                let iterations = 0;
                // Clear any existing interval just in case
                if(el._decipherInterval) clearInterval(el._decipherInterval);

                el._decipherInterval = setInterval(() => {
                    el.innerText = originalText.split('').map((letter: string, index: number) => {
                        if(index < iterations) {
                            return originalText[index];
                        }
                        return characters[Math.floor(Math.random() * characters.length)];
                    }).join('');

                    if(iterations >= originalText.length) {
                        clearInterval(el._decipherInterval);
                        el.innerText = originalText;
                    }
                    iterations += 1/3;
                }, 30);
            };

            el._mouseLeaveHandler = () => {
                const originalText = el.getAttribute('data-original');
                if(originalText) {
                    clearInterval(el._decipherInterval);
                    el.innerText = originalText;
                }
            };

            el.addEventListener('mouseenter', el._mouseEnterHandler);
            el.addEventListener('mouseleave', el._mouseLeaveHandler);
        });
    });
</script>
