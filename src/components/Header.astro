---
import ThemeToggle from "./ThemeToggle.astro";
import Logo from "./Logo.astro";
---

<header class="bg-background/80 sticky top-0 z-40 w-full border-b backdrop-blur-sm">
  <div class="container flex h-16 items-center justify-between">
    <Logo />
    <div class="flex items-center gap-4">
      <ThemeToggle transition:persist />
      <a href="/about" class="text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 focus:outline-none focus:ring-4 focus:ring-gray-200 dark:focus:ring-gray-700 rounded-lg text-sm p-2.5">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.121 17.804A13.937 13.937 0 0112 16c2.5 0 4.847.655 6.879 1.804M15 10a3 3 0 11-6 0 3 3 0 016 0zm-2 9.172V19.5a2.5 2.5 0 002.5-2.5V10.5a2.5 2.5 0 00-5 0v6.5a2.5 2.5 0 002.5 2.5v-2.328" /></svg>
      </a>
    </div>
  </div>
</header>
