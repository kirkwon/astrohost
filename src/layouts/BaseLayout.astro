---
import { ViewTransitions } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@700&display=swap" rel="stylesheet"> 
    
    <ViewTransitions />
    
    <script is:inline>
        // Theme toggling script
        const theme = (() => {
            if (typeof localStorage !== "undefined" && localStorage.getItem("color-theme")) {
                return localStorage.getItem("color-theme");
            }
            if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
                return "dark";
            }
            return "light";
        })();

        if (theme === "light") {
            document.documentElement.classList.remove("dark");
        } else {
            document.documentElement.classList.add("dark");
        }

        function setupThemeToggle() {
            const toggleBtn = document.getElementById('theme-toggle');
            if (toggleBtn) {
                const isDark = document.documentElement.classList.contains('dark');
                toggleBtn.setAttribute('aria-checked', isDark);

                toggleBtn.addEventListener('click', () => {
                    const isDark = document.documentElement.classList.toggle('dark');
                    localStorage.setItem('color-theme', isDark ? 'dark' : 'light');
                    toggleBtn.setAttribute('aria-checked', isDark);
                });
            }
        }
        
        // Fallback for browsers that don't support View Transitions
        if (document.startViewTransition === undefined) {
            window.addEventListener("click", (e) => {
                const link = e.target.closest("a");
                if (link && link.origin === window.location.origin) {
                    e.preventDefault();
                    document.body.classList.add("page-leave");
                    setTimeout(() => {
                        window.location.href = link.href;
                    }, 300);
                }
            });
        }

        document.addEventListener('DOMContentLoaded', setupThemeToggle);
        document.addEventListener('astro:after-swap', setupThemeToggle);
    </script>
</head>
<body class="font-sans bg-background text-foreground" transition:animate="fade">
    <Header />
    <main class="container mx-auto px-4 py-6">
        <slot />
    </main>
    <Footer />
</body>
</html>
<style is:global>
    @keyframes fade-in {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    @keyframes fade-out {
        from { opacity: 1; }
        to { opacity: 0; }
    }

    ::view-transition-old(root) {
        animation: fade-out 400ms cubic-bezier(0.4, 0, 0.2, 1) both;
    }
    ::view-transition-new(root) {
        animation: fade-in 400ms cubic-bezier(0.4, 0, 0.2, 1) both;
    }

    .page-leave {
        animation: fade-out 300ms ease-out forwards;
    }
    
    /* Apply fade-in on initial load for non-transition browsers */
    body {
       animation: fade-in 400ms ease-in forwards;
    }
</style>
