---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout title="My Astro Blog">
	<h1 class="text-4xl font-bold mb-4 dark:text-white">A Brief History of Modern AI</h1>
	<p class="text-xl text-gray-600 dark:text-gray-300 mb-8">A year-by-year account of the major advancements in AI and machine learning.</p>
	<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
		{posts.map(post => (
			<Card post={post} />
		))}
	</div>
</Layout>
