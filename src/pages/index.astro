---
import BaseLayout from "../layouts/BaseLayout.astro";
export const prerender = true;
import { getCollection } from "astro:content";
import Card from "../components/Card.astro";
import TitleImageCarousel from "../components/TitleImageCarousel";

const posts = (await getCollection("blog")).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout title="My Astro Blog">
	<section class="py-20 relative">
		<div class="container text-center relative z-10">
			<TitleImageCarousel
				client:load
				titleText="A Brief History of Modern AI"
				subtitleText="A year-by-year account of the major advancements in AI and machine learning 🚀"
				imageSrc="/images/BriefHistoryAI.png"
				imageAlt="A Brief History of Modern AI Visualization"
				imageTitle="Visual History"
			/>
		</div>
	</section>

	<section class="py-12 relative flex">
		<div class="hidden lg:flex w-1/4 sticky top-32 h-screen flex-col items-center pl-8 text-primary/30">
			<div id="sticky-year" class="text-8xl font-black font-mono split-flap opacity-50 transition-opacity duration-300">
				2026
			</div>
		</div>
		<div class="w-full lg:w-3/4 container relative timeline-container">
			<div class="absolute left-1/2 md:left-8 top-0 bottom-0 w-1 bg-slate-200 dark:bg-slate-700 -translate-x-1/2">
                <div id="scroll-progress-line" class="absolute top-0 left-0 w-full bg-primary-500 shadow-[0_0_15px_rgba(16,185,129,0.8)] h-0"></div>
            </div>

			<div class="flex flex-col gap-16 md:gap-24">
				{posts.map((post, index) => (
                    <div class={`timeline-item relative flex w-full justify-between items-center ${index % 2 === 0 ? 'md:flex-row-reverse' : 'md:flex-row'} flex-col`} data-year={new Date(post.data.pubDate).getFullYear()}>
                        <div class="hidden md:block w-[45%]"></div>
                        <div class="absolute left-1/2 md:left-8 w-6 h-6 rounded-full bg-primary-500 border-4 border-background z-10 -translate-x-1/2 shadow-[0_0_10px_rgba(16,185,129,0.8)] glow-node"></div>
                        <div class="w-full md:w-[85%] pl-12 md:pl-0 md:ml-16">
                            <Card post={post} />
                        </div>
                    </div>
				))}
			</div>
		</div>
	</section>

    <script>
        import { gsap } from "gsap";
        import { ScrollTrigger } from "gsap/ScrollTrigger";

        gsap.registerPlugin(ScrollTrigger);

        document.addEventListener("DOMContentLoaded", () => {
            // Scroll Progress Line
            gsap.to("#scroll-progress-line", {
                height: "100%",
                ease: "none",
                scrollTrigger: {
                    trigger: ".timeline-container",
                    start: "top center",
                    end: "bottom center",
                    scrub: true
                }
            });

            // Sticky Year Tracker and Node glowing
            const timelineItems = document.querySelectorAll(".timeline-item");
            const stickyYear = document.getElementById("sticky-year");

            timelineItems.forEach((item) => {
                const year = item.getAttribute("data-year");
                const node = item.querySelector(".glow-node");

                ScrollTrigger.create({
                    trigger: item,
                    start: "top center",
                    end: "bottom center",
                    onEnter: () => {
                        if(stickyYear) {
                            stickyYear.innerText = year;
                            stickyYear.style.opacity = "1";
                            // Split-flap effect simulation
                            gsap.fromTo(stickyYear,
                                { rotationX: -90, opacity: 0 },
                                { rotationX: 0, opacity: 1, duration: 0.5, ease: "back.out(1.7)" }
                            );
                        }
                        gsap.to(node, { scale: 1.5, backgroundColor: "#34d399", duration: 0.3 });
                    },
                    onEnterBack: () => {
                        if(stickyYear) {
                            stickyYear.innerText = year;
                            stickyYear.style.opacity = "1";
                            gsap.fromTo(stickyYear,
                                { rotationX: 90, opacity: 0 },
                                { rotationX: 0, opacity: 1, duration: 0.5, ease: "back.out(1.7)" }
                            );
                        }
                        gsap.to(node, { scale: 1.5, backgroundColor: "#34d399", duration: 0.3 });
                    },
                    onLeave: () => {
                        gsap.to(node, { scale: 1, backgroundColor: "#10b981", duration: 0.3 });
                    },
                    onLeaveBack: () => {
                        gsap.to(node, { scale: 1, backgroundColor: "#10b981", duration: 0.3 });
                    }
                });
            });
        });
    </script>
</BaseLayout>
