---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout title="My Astro Blog">
	<section class="py-20">
		<div class="container text-center">
			<h1 class="font-heading text-6xl md:text-7xl lg:text-8xl font-black mb-6">
				A Brief History of Modern AI
			</h1>
			<p class="text-2xl text-muted-foreground font-medium mb-10">
				A year-by-year account of the major advancements in AI and machine learning
			</p>

			<!-- Timeline Navigation -->
			<div class="flex flex-wrap justify-center gap-3 mb-8">
				{posts.map(post => (
					<a href={`/blog/${post.slug}`} class="px-4 py-2 bg-secondary text-secondary-foreground hover:bg-primary hover:text-primary-foreground font-bold rounded-lg transition-all duration-200 text-lg shadow-md hover:shadow-xl transform hover:-translate-y-1 hover:scale-110">
						{new Date(post.data.pubDate).getFullYear()}
					</a>
				))}
			</div>
		</div>
	</section>

	<section class="py-12">
		<div class="container">
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
				{posts.map(post => (
					<Card post={post} />
				))}
			</div>
		</div>
	</section>
</Layout>
