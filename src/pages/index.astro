---
import BaseLayout from "../layouts/BaseLayout.astro";
export const prerender = true;
import { getCollection } from "astro:content";
import Card from "../components/Card.astro";

import TitleImageCarousel from "../components/TitleImageCarousel";

const posts = (await getCollection("blog")).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout title="My Astro Blog">
	<section class="py-20">
		<div class="container text-center">
			<TitleImageCarousel
				client:load
				titleText="A Brief History of Modern AI"
				subtitleText="A year-by-year account of the major advancements in AI and machine learning 🚀"
				imageSrc="/images/BriefHistoryAI.png"
				imageAlt="A Brief History of Modern AI Visualization"
				imageTitle="Visual History"
			/>

			<!-- Timeline Navigation -->
			<div class="flex flex-wrap justify-center gap-3 mb-8">
				{
					posts.map((post) => (
						<a
							href={`/blog/${post.slug}`}
							class="glow-on-hover px-4 py-2 bg-secondary text-secondary-foreground hover:bg-primary hover:text-primary-foreground font-bold rounded-lg transition-all duration-200 text-lg shadow-md hover:shadow-xl transform hover:-translate-y-1 hover:scale-110"
						>
							{new Date(post.data.pubDate).getFullYear()}
						</a>
					))
				}
			</div>
		</div>
	</section>

	<section class="py-12">
		<div class="container">
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
				{posts.map((post) => <Card post={post} />)}
			</div>
		</div>
	</section>
</BaseLayout>
