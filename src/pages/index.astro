---
import BaseLayout from "../layouts/BaseLayout.astro";
export const prerender = true;
import { getCollection } from "astro:content";
import Card from "../components/Card.astro";

import TitleImageCarousel from "../components/TitleImageCarousel";

const posts = (await getCollection("blog")).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout title="My Astro Blog">
	<section class="py-20">
		<div class="container text-center">
			<TitleImageCarousel
				client:load
				title={(
					<h1 class="scroll-animate font-heading text-6xl md:text-7xl lg:text-8xl font-black mb-6">
						A Brief History of Modern AI{" "}
						<span class="robot-emoji">🤖</span>
					</h1>
				)}
				subtitle={(
					<p class="scroll-animate text-2xl text-muted-foreground font-medium mb-10">
						A year-by-year account of the major advancements in AI
						and machine learning 🚀
					</p>
				)}
				imageSrc="/images/BriefHistoryAI.png"
				imageAlt="A Brief History of Modern AI Visualization"
			/>

			<!-- Timeline Navigation -->
			<div class="flex flex-wrap justify-center gap-3 mb-8">
				{
					posts.map((post) => (
						<a
							href={`/blog/${post.slug}`}
							class="glow-on-hover px-4 py-2 bg-secondary text-secondary-foreground hover:bg-primary hover:text-primary-foreground font-bold rounded-lg transition-all duration-200 text-lg shadow-md hover:shadow-xl transform hover:-translate-y-1 hover:scale-110"
						>
							{new Date(post.data.pubDate).getFullYear()}
						</a>
					))
				}
			</div>
		</div>
	</section>

	<section class="py-12">
		<div class="container">
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
				{posts.map((post) => <Card post={post} />)}
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.robot-emoji {
		display: inline-block;
		cursor: default;
	}

	.robot-emoji:hover {
		animation: robot-shake 0.8s cubic-bezier(0.36, 0.07, 0.19, 0.97) both;
		transform: translate3d(0, 0, 0);
		backface-visibility: hidden;
		perspective: 1000px;
	}

	@keyframes robot-shake {
		10%,
		90% {
			transform: translate3d(-1px, 0, 0) rotate(-5deg);
		}

		20%,
		80% {
			transform: translate3d(2px, 0, 0) rotate(5deg);
		}

		30%,
		50%,
		70% {
			transform: translate3d(-4px, 0, 0) rotate(-5deg);
		}

		40%,
		60% {
			transform: translate3d(4px, 0, 0) rotate(5deg);
		}
	}
</style>
