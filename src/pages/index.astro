---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout title="My Astro Blog">
	<div class="text-center mb-12">
		<h1 class="text-6xl md:text-7xl lg:text-8xl font-black mb-6 bg-gradient-to-r from-primary-700 to-slate-700 dark:from-primary-400 dark:to-slate-400 bg-clip-text text-transparent">
			A Brief History of Modern AI
		</h1>
		<p class="text-2xl text-slate-600 dark:text-slate-300 font-medium mb-10">
			A year-by-year account of the major advancements in AI and machine learning
		</p>

		<!-- Timeline Navigation -->
		<div class="flex flex-wrap justify-center gap-3 mb-8">
			{posts.map(post => (
				<a href={`/blog/${post.slug}`} class="px-4 py-2 bg-primary-100 dark:bg-slate-700 hover:bg-primary-500 hover:text-white dark:hover:bg-primary-600 dark:hover:text-white text-primary-800 dark:text-primary-200 font-bold rounded-lg transition-all duration-200 text-lg shadow-md hover:shadow-xl transform hover:-translate-y-1 hover:scale-110">
					{new Date(post.data.pubDate).getFullYear()}
				</a>
			))}
		</div>
	</div>
	<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
		{posts.map(post => (
			<Card post={post} />
		))}
	</div>
</Layout>
