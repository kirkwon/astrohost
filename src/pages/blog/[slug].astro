---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
---

<Layout title={post.data.title}>
  <article class="prose dark:prose-invert lg:prose-xl mx-auto">
    <h1 class="text-4xl font-bold mb-4 dark:text-white">{post.data.title}</h1>
		<p class="text-lg text-gray-600 dark:text-gray-400 mb-8">Published on: {post.data.pubDate.toDateString()}</p>
    <Content />
  </article>
</Layout>
