---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
---

<Layout title={post.data.title}>
  <article class="prose dark:prose-invert mx-auto py-8">
    <h1 transition:name={`post-title-${post.slug}`} class="text-5xl font-black mb-6 bg-gradient-to-r from-primary-700 to-slate-700 dark:from-primary-400 dark:to-slate-400 bg-clip-text text-transparent">{post.data.title}</h1>
    <div class="not-prose mb-8 p-4 bg-secondary rounded-lg border-l-4 border-primary">
      <p class="text-lg font-semibold text-secondary-foreground">Published on: {post.data.pubDate.toDateString()}</p>
    </div>
    <Content />
  </article>
</Layout>
